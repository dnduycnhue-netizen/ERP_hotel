# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng ở server (route /api/cron, /api/import, /api/export). Không bao giờ đặt tiền tố NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Cron
CRON_SECRET=

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email (đặt trong Supabase secrets cho Edge Function)
RESEND_API_KEY=

# Zalo OA (đặt trong Supabase secrets, khi có OA)
ZALO_OA_APP_ID=
ZALO_OA_SECRET=
